# Gemini API Key for AI processing
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override Gemini models without editing code
# VITE_GEMINI_FLASH_MODEL=gemini-3.8-flash
# VITE_GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-2.5-flash
# VITE_GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Google OAuth2 Configuration (for Gmail access)
# You can either use these env vars OR create an oauth2.config.json file (which is gitignored)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Network Proxy (Optional)
# HTTPS_PROXY=http://127.0.0.1:7890
